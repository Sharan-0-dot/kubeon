# Kubeon Environment Configuration
# Copy this file to .env and fill in your values.
# .env is ignored by git to protect credentials.

# ── Required ──────────────────────────────────────────────

# Google Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL database password
DB_PASSWORD=your_database_password_here

# ── Optional (defaults shown) ────────────────────────────

# Gemini model selection
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/kubeon
DB_USERNAME=postgres

# Slack incoming webhook URL (leave empty to disable notifications)
SLACK_WEBHOOK_URL=

# Maximum agentic tool calls per investigation
MAX_TOOL_CALLS=3

# Enable sensitive data redaction before LLM, storage, and notifications
REDACTION_ENABLED=true
